
<section class="horizontal-collection-showcase section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="hcs-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="hcs-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}

        {% if collection != blank and collection.products.size > 0 %}
          {% assign product = collection.products.first %}
          {% assign current_variant = product.selected_or_first_available_variant %}

          <div class="hcs-card" {{ block.shopify_attributes }}>
            <div
              class="hcs-card-inner"
              data-product-id="{{ product.id }}"
              data-product-url="{{ product.url }}"
            >

              <script type="application/json" class="hcs-variants-json">
                {{ product.variants | json }}
              </script>

              {%- if product.compare_at_price > product.price -%}
                <span class="hcs-sale-badge">Sale</span>
              {%- endif -%}

              <div class="hcs-image-wrapper">
                <div class="hcs-slides">
                  {% for image in product.images limit: 10 %}
                    <div class="hcs-slide" data-image-id="{{ image.id }}">
                      <a href="{{ product.url }}" class="hcs-image-link">
                        <img
                          src="{{ image | image_url: width: 800 }}"
                          alt="{{ product.title | escape }}"
                          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                          class="hcs-image"
                        >
                      </a>
                    </div>
                  {% endfor %}
                </div>

                {% if product.images.size > 1 %}
                  <button class="hcs-arrow hcs-prev" type="button" aria-label="Previous image">&#8249;</button>
                  <button class="hcs-arrow hcs-next" type="button" aria-label="Next image">&#8250;</button>
                {% endif %}
              </div>

              <div class="hcs-content">
                <h3 class="hcs-title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <div class="hcs-price">
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="hcs-compare-price">
                      {{ current_variant.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span class="hcs-current-price">
                    {{ current_variant.price | money }}
                  </span>
                </div>

                {% assign color_option_index = nil %}
                {% for option in product.options_with_values %}
                  {% assign option_name = option.name | downcase %}
                  {% if option_name == 'color' or option_name == 'colour' %}
                    {% assign color_option_index = forloop.index0 %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% if color_option_index != nil %}
                  <div class="hcs-swatches" data-option-index="{{ color_option_index }}">
                    {% assign shown_colors = '' %}
                    {% assign visible_count = 0 %}
                    {% assign extra_count = 0 %}

                    {% for variant in product.variants %}
                      {% assign color_value = variant.options[color_option_index] %}
                      {% assign token = '|' | append: color_value | append: '|' %}

                      {% unless shown_colors contains token %}
                        {% assign shown_colors = shown_colors | append: token %}

                        {% if visible_count < 6 %}
                          <button
                            type="button"
                            class="hcs-swatch{% if visible_count == 0 %} active{% endif %}"
                            data-value="{{ color_value | escape }}"
                            data-image-id="{% if variant.featured_image %}{{ variant.featured_image.id }}{% endif %}"
                            title="{{ color_value }}"
                            style="background-color: {{ color_value | downcase }};"
                          ></button>
                          {% assign visible_count = visible_count | plus: 1 %}
                        {% else %}
                          {% assign extra_count = extra_count | plus: 1 %}
                        {% endif %}
                      {% endunless %}
                    {% endfor %}

                    {% if extra_count > 0 %}
                      <span class="hcs-extra">+{{ extra_count }}</span>
                    {% endif %}
                  </div>
                {% endif %}

                {% assign size_option_index = nil %}
                {% for option in product.options_with_values %}
                  {% assign option_name = option.name | downcase %}
                  {% if option_name == 'size' %}
                    {% assign size_option_index = forloop.index0 %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {%- comment -%}
REPLACE ONLY THIS SIZE BUTTON CODE IN YOUR SECTION

Find this block:

{% if size_option_index != nil %}
  <div class="hcs-sizes" data-option-index="{{ size_option_index }}">
    {% assign shown_sizes = '' %}

    {% for variant in product.variants %}
      {% assign size_value = variant.options[size_option_index] %}
      {% assign token = '|' | append: size_value | append: '|' %}

      {% unless shown_sizes contains token %}
        {% assign shown_sizes = shown_sizes | append: token %}
        <button
          type="button"
          class="hcs-size{% if forloop.first %} active{% endif %}"
          data-value="{{ size_value | escape }}"
        >
          {{ size_value }}
        </button>
      {% endunless %}
    {% endfor %}
  </div>
{% endif %}

AND REPLACE IT WITH THE CODE BELOW.
{%- endcomment -%}

{% if size_option_index != nil %}
  <div class="hcs-sizes" data-option-index="{{ size_option_index }}">
    {% assign shown_sizes = '' %}
    {% assign first_size_set = false %}

    {% for variant in product.variants %}
      {% assign size_value = variant.options[size_option_index] %}
      {% assign token = '|' | append: size_value | append: '|' %}

      {% unless shown_sizes contains token %}
        {% assign shown_sizes = shown_sizes | append: token %}

        {%- comment -%}
        Check if this size has ANY available variant
        (any color + this size)
        {%- endcomment -%}
        {% assign size_available = false %}

        {% for check_variant in product.variants %}
          {% if check_variant.options[size_option_index] == size_value and check_variant.available %}
            {% assign size_available = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        <button
          type="button"
          class="hcs-size{% if first_size_set == false and size_available %} active{% assign first_size_set = true %}{% endif %}{% unless size_available %} disabled{% endunless %}"
          data-value="{{ size_value | escape }}"
          {% unless size_available %}aria-disabled="true"{% endunless %}
        >
          {{ size_value }}
        </button>
      {% endunless %}
    {% endfor %}
  </div>
{% endif %}

                <input
                  type="hidden"
                  class="hcs-variant-id"
                  value="{{ current_variant.id }}"
                >

                <a href="{{ product.url }}?variant={{ current_variant.id }}"
                class="hcs-add-to-cart hcs-submit-button{% unless current_variant.available %} disabled{% endunless %}"
                {% unless current_variant.available %}aria-disabled="true"{% endunless %}
                >
                {% if current_variant.available %}
                    Submit
                {% else %}
                    Sold Out
                {% endif %}
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
.section-{{ section.id }} {
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background }};
}

.hcs-heading {
  text-align: center;
  margin-bottom: 40px;
  font-size: 36px;
  font-weight: 700;
}

.hcs-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: 12px;
}

.hcs-card {
  border-radius: 0;
  overflow: hidden;
  position: relative;
  transition: all 0.3s ease;
}

.hcs-card:hover {
  transform: translateY(-5px);
}

.hcs-sale-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  background: #ff5a3c;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 4px;
  z-index: 2;
}

.hcs-image-link,
.hcs-title a {
  text-decoration: none;
  color: inherit;
}

.hcs-image-wrapper {
  background: #ececec;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  position: relative;
}

.hcs-slides {
  display: flex;
  height: 100%;
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform;
}

.hcs-slide {
  min-width: 100%;
  height: 100%;
  flex-shrink: 0;
}

.hcs-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.hcs-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.85);
  border: none;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  font-size: 22px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.25s ease, background 0.2s ease;
  z-index: 5;
  padding: 0;
  color: #111;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.hcs-arrow:hover {
  background: #fff;
}

.hcs-prev { left: 10px; }
.hcs-next { right: 10px; }

.hcs-card:hover .hcs-arrow {
  opacity: 1;
}

.hcs-card-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.hcs-content {
  padding: 10px;
  text-align: center;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.hcs-title {
  font-size: 14px;
    font-weight: 600;
    margin: 0 0 12px;
    line-height: 1.3;
    color: #000;
}

.hcs-price {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.hcs-compare-price {
  color: #999;
  text-decoration: line-through;
  font-size: 16px;
  font-weight: 500;
}

.hcs-current-price {
  color: #111;
  font-size: 18px;
  font-weight: 700;
}

.hcs-swatches,
.hcs-sizes {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.hcs-swatches {
  margin-bottom: 12px;
}

.hcs-sizes {
  margin-bottom: 16px;
}

.hcs-swatch {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1px solid #999;
  cursor: pointer;
  padding: 0;
}

.hcs-swatch.active {
  border: 2px solid #111;
  transform: scale(1.1);
}

.hcs-size {
  font-size: 13px;
  font-weight: 600;
  border: 1px solid #ddd;
  padding: 4px 8px;
  border-radius: 4px;
  background: #fff;
  cursor: pointer;
}

.hcs-size.active {
  background: #111;
  color: #fff;
  border-color: #111;
}

.hcs-extra {
  font-size: 18px;
  font-weight: 500;
  color: #333;
}

.hcs-add-to-cart {
  width: 100%;
  padding: 8px 10px;
  border: none;
  border-radius: 0;
  background: #111;
  color: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: 0.3s;
  display: block;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1px;
  text-align: center;
  margin-top: auto;
  text-decoration: none;
  box-sizing: border-box;
}

.hcs-add-to-cart:hover {
  background: #333;
}

.hcs-add-to-cart:disabled {
  background: #999;
  cursor: not-allowed;
}
/* Disabled state styles */

.hcs-size.disabled,
.hcs-swatch.disabled {
  opacity: 0.4;
  cursor: not-allowed;
  pointer-events: none;
}

.hcs-size.disabled {
  text-decoration: line-through;
}

.hcs-swatch.disabled {
  position: relative;
}

.hcs-swatch.disabled::after {
  content: '';
  position: absolute;
  top: 50%;
  left: -2px;
  width: calc(100% + 4px);
  height: 2px;
  background: #111;
  transform: rotate(-45deg);
}
@media screen and (max-width: 991px) {
  .hcs-grid {
    grid-template-columns: repeat(2, 1fr);
  }


  .hcs-current-price,
  .hcs-compare-price {
    font-size: 18px;
  }
}

@media screen and (max-width: 767px) {
  .hcs-grid {
    grid-template-columns: 1fr;
  }

  .hcs-heading {
    font-size: 28px;
  }
}
</style>


<script>
document.addEventListener('DOMContentLoaded', function () {

  function formatMoney(cents) {
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, "{{ shop.money_format }}");
    }
    return (cents / 100).toFixed(2);
  }

  function getVariants(card) {
    const json = card.querySelector('.hcs-variants-json');
    if (!json) return [];
    try { return JSON.parse(json.textContent); } catch (e) { return []; }
  }

  function getOptionIndexes(card) {
    const swatches = card.querySelector('.hcs-swatches');
    const sizes = card.querySelector('.hcs-sizes');
    return {
      colorIndex: swatches ? parseInt(swatches.dataset.optionIndex, 10) : null,
      sizeIndex: sizes ? parseInt(sizes.dataset.optionIndex, 10) : null
    };
  }

  function getSelectedValues(card) {
    const activeSwatch = card.querySelector('.hcs-swatch.active');
    const activeSize = card.querySelector('.hcs-size.active');
    return {
      color: activeSwatch ? activeSwatch.dataset.value : null,
      size: activeSize ? activeSize.dataset.value : null
    };
  }

  function findVariant(card) {
    const variants = getVariants(card);
    const { colorIndex, sizeIndex } = getOptionIndexes(card);
    const { color, size } = getSelectedValues(card);

    let matched = variants.find(function (v) {
      if (color && colorIndex !== null && v.options[colorIndex] !== color) return false;
      if (size && sizeIndex !== null && v.options[sizeIndex] !== size) return false;
      return true;
    });

    if (!matched) matched = variants.find(v => v.available) || variants[0];
    return matched;
  }

  /* ── Slider ── */
  function getSlideIndex(card) {
    return parseInt(card.dataset.slideIndex || '0', 10);
  }

  function goToSlide(card, index) {
    const slides = card.querySelectorAll('.hcs-slide');
    if (!slides.length) return;
    index = Math.max(0, Math.min(index, slides.length - 1));
    card.dataset.slideIndex = index;
    const track = card.querySelector('.hcs-slides');
    if (track) track.style.transform = 'translateX(-' + (index * 100) + '%)';
  }

  function goToImageById(card, imageId, persist) {
    if (!imageId) return;
    const slides = card.querySelectorAll('.hcs-slide');
    slides.forEach(function (slide, i) {
      if (String(slide.dataset.imageId) === String(imageId)) {
        if (persist) {
          goToSlide(card, i);
        } else {
          const track = card.querySelector('.hcs-slides');
          if (track) track.style.transform = 'translateX(-' + (i * 100) + '%)';
        }
      }
    });
  }

  /* ── Availability ── */
  function updateSizeAvailability(card) {
    const variants = getVariants(card);
    const { colorIndex, sizeIndex } = getOptionIndexes(card);
    const { color } = getSelectedValues(card);
    if (sizeIndex === null) return;

    card.querySelectorAll('.hcs-size').forEach(function (btn) {
      const available = variants.some(function (v) {
        const colorOk = !color || colorIndex === null || v.options[colorIndex] === color;
        return colorOk && v.options[sizeIndex] === btn.dataset.value && v.available;
      });
      btn.classList.toggle('disabled', !available);
      btn.toggleAttribute('aria-disabled', !available);
      if (!available) btn.classList.remove('active');
    });

    if (!card.querySelector('.hcs-size.active')) {
      const first = card.querySelector('.hcs-size:not(.disabled)');
      if (first) first.classList.add('active');
    }
  }

  function updateColorAvailability(card) {
    const variants = getVariants(card);
    const { colorIndex, sizeIndex } = getOptionIndexes(card);
    const { size } = getSelectedValues(card);
    if (colorIndex === null) return;

    card.querySelectorAll('.hcs-swatch').forEach(function (btn) {
      const available = variants.some(function (v) {
        const sizeOk = !size || sizeIndex === null || v.options[sizeIndex] === size;
        return v.options[colorIndex] === btn.dataset.value && sizeOk && v.available;
      });
      btn.classList.toggle('disabled', !available);
      btn.toggleAttribute('aria-disabled', !available);
      if (!available) btn.classList.remove('active');
    });

    if (!card.querySelector('.hcs-swatch.active')) {
      const first = card.querySelector('.hcs-swatch:not(.disabled)');
      if (first) first.classList.add('active');
    }
  }

  /* ── Update card UI ── */
  function updateCard(card) {
    updateSizeAvailability(card);
    updateColorAvailability(card);

    const variant = findVariant(card);
    if (!variant) return;

    const productUrl = card.dataset.productUrl;
    const variantUrl = productUrl + '?variant=' + variant.id;

    const hiddenInput = card.querySelector('.hcs-variant-id');
    if (hiddenInput) hiddenInput.value = variant.id;

    card.querySelectorAll('.hcs-image-link, .hcs-title a, .hcs-submit-button').forEach(function (link) {
      if (link.tagName.toLowerCase() === 'a') link.href = variantUrl;
    });

    // Navigate slider to variant image
    if (variant.featured_image && variant.featured_image.id) {
      goToImageById(card, variant.featured_image.id, true);
    }

    const currentPrice = card.querySelector('.hcs-current-price');
    const priceWrapper = card.querySelector('.hcs-price');
    let comparePrice = card.querySelector('.hcs-compare-price');

    if (currentPrice) currentPrice.textContent = formatMoney(variant.price);

    if (variant.compare_at_price && variant.compare_at_price > variant.price) {
      if (!comparePrice && priceWrapper) {
        comparePrice = document.createElement('span');
        comparePrice.className = 'hcs-compare-price';
        priceWrapper.insertBefore(comparePrice, currentPrice);
      }
      if (comparePrice) comparePrice.textContent = formatMoney(variant.compare_at_price);
    } else if (comparePrice) {
      comparePrice.remove();
    }

    const submitButton = card.querySelector('.hcs-submit-button');
    if (submitButton) {
      const avail = variant.available;
      submitButton.classList.toggle('disabled', !avail);
      submitButton.toggleAttribute('aria-disabled', !avail);
      submitButton.textContent = avail ? 'Submit' : 'Sold Out';
    }
  }

  function activate(button, selector) {
    if (button.classList.contains('disabled')) return false;
    button.parentElement.querySelectorAll(selector).forEach(el => el.classList.remove('active'));
    button.classList.add('active');
    return true;
  }

  /* ── Events ── */
  document.addEventListener('click', function (e) {
    // Arrow prev/next
    const arrow = e.target.closest('.hcs-arrow');
    if (arrow) {
      e.preventDefault();
      const card = arrow.closest('.hcs-card-inner');
      if (!card) return;
      const slides = card.querySelectorAll('.hcs-slide');
      let idx = getSlideIndex(card);
      if (arrow.classList.contains('hcs-prev')) {
        idx = idx > 0 ? idx - 1 : slides.length - 1;
      } else {
        idx = idx < slides.length - 1 ? idx + 1 : 0;
      }
      goToSlide(card, idx);
      return;
    }

    // Swatch click
    const swatch = e.target.closest('.hcs-swatch');
    if (swatch) {
      e.preventDefault();
      const card = swatch.closest('.hcs-card-inner');
      if (!card) return;
      if (activate(swatch, '.hcs-swatch')) {
        updateCard(card);
      }
      return;
    }

    // Size click
    const size = e.target.closest('.hcs-size');
    if (size) {
      e.preventDefault();
      const card = size.closest('.hcs-card-inner');
      if (!card) return;
      if (activate(size, '.hcs-size')) {
        updateCard(card);
      }
      return;
    }

    if (e.target.closest('.hcs-submit-button.disabled')) e.preventDefault();
  });

  // Swatch hover → preview image
  document.addEventListener('mouseover', function (e) {
    const swatch = e.target.closest('.hcs-swatch');
    if (!swatch || swatch.classList.contains('disabled')) return;
    const card = swatch.closest('.hcs-card-inner');
    if (!card) return;
    const imageId = swatch.dataset.imageId;
    if (imageId) goToImageById(card, imageId, false);
  });

  // Swatch mouse leave → restore selected slide
  document.addEventListener('mouseout', function (e) {
    const swatch = e.target.closest('.hcs-swatch');
    if (!swatch) return;
    if (e.relatedTarget && e.relatedTarget.closest('.hcs-swatch')) return;
    const card = swatch.closest('.hcs-card-inner');
    if (!card) return;
    goToSlide(card, getSlideIndex(card));
  });

  /* ── Init ── */
  document.querySelectorAll('.hcs-card-inner').forEach(function (card) {
    updateCard(card);
  });
});
</script>


{% schema %}
{
  "name": "Custom Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Column",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid",
      "category": "Custom",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}