
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section class="horizontal-collection-showcase section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="hcs-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="swiper hcs-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% assign collection = collections[block.settings.collection] %}

          {% if collection != blank and collection.products.size > 0 %}
            {% assign product = collection.products.first %}
            {% assign current_variant = product.selected_or_first_available_variant %}

            <div class="swiper-slide">
              <div class="hcs-card" {{ block.shopify_attributes }}>
                <div
                  class="hcs-card-inner"
                  data-product-id="{{ product.id }}"
                  data-product-url="{{ product.url }}"
                >

                  <script type="application/json" class="hcs-variants-json">
                    {{ product.variants | json }}
                  </script>

                  {%- if product.compare_at_price > product.price -%}
                    <span class="hcs-sale-badge">Sale</span>
                  {%- endif -%}

                  <div class="hcs-image-wrapper">
                    <div class="swiper hcs-inner-swiper">
                      <div class="swiper-wrapper">
                        {% for image in product.images limit: 10 %}
                          <div class="swiper-slide hcs-slide" data-image-id="{{ image.id }}">
                            <a href="{{ product.url }}" class="hcs-image-link">
                              <img
                                src="{{ image | image_url: width: 800 }}"
                                alt="{{ product.title | escape }}"
                                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                                class="hcs-image"
                              >
                            </a>
                          </div>
                        {% endfor %}
                      </div>
                      {% if product.images.size > 1 %}
                        <div class="hcs-nav hcs-nav-prev">&#8249;</div>
                        <div class="hcs-nav hcs-nav-next">&#8250;</div>
                      {% endif %}
                    </div>
                  </div>

                  <div class="hcs-content">
                    <h3 class="hcs-title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>

                    <div class="hcs-price">
                      {% if current_variant.compare_at_price > current_variant.price %}
                        <span class="hcs-compare-price">
                          {{ current_variant.compare_at_price | money }}
                        </span>
                      {% endif %}
                      <span class="hcs-current-price">
                        {{ current_variant.price | money }}
                      </span>
                    </div>

                    {% assign color_option_index = nil %}
                    {% for option in product.options_with_values %}
                      {% assign option_name = option.name | downcase %}
                      {% if option_name == 'color' or option_name == 'colour' %}
                        {% assign color_option_index = forloop.index0 %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% if color_option_index != nil %}
                      <div class="hcs-swatches" data-option-index="{{ color_option_index }}">
                        {% assign shown_colors = '' %}
                        {% assign visible_count = 0 %}
                        {% assign extra_count = 0 %}

                        {% for variant in product.variants %}
                          {% assign color_value = variant.options[color_option_index] %}
                          {% assign token = '|' | append: color_value | append: '|' %}

                          {% unless shown_colors contains token %}
                            {% assign shown_colors = shown_colors | append: token %}

                            {% if visible_count < 5 %}
                              <button
                                type="button"
                                class="hcs-swatch{% if visible_count == 0 %} active{% endif %}"
                                data-value="{{ color_value | escape }}"
                                data-image-id="{% if variant.featured_image %}{{ variant.featured_image.id }}{% endif %}"
                                title="{{ color_value }}"
                                style="background-color: {{ color_value | downcase }};"
                              ></button>
                              {% assign visible_count = visible_count | plus: 1 %}
                            {% else %}
                              {% assign extra_count = extra_count | plus: 1 %}
                            {% endif %}
                          {% endunless %}
                        {% endfor %}

                        {% if extra_count > 0 %}
                          <span class="hcs-extra">+{{ extra_count }}</span>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% assign size_option_index = nil %}
                    {% for option in product.options_with_values %}
                      {% assign option_name = option.name | downcase %}
                      {% if option_name == 'size' %}
                        {% assign size_option_index = forloop.index0 %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% if size_option_index != nil %}
                      <div class="hcs-sizes" data-option-index="{{ size_option_index }}">
                        {% assign shown_sizes = '' %}
                        {% assign first_size_set = false %}

                        {% for variant in product.variants %}
                          {% assign size_value = variant.options[size_option_index] %}
                          {% assign token = '|' | append: size_value | append: '|' %}

                          {% unless shown_sizes contains token %}
                            {% assign shown_sizes = shown_sizes | append: token %}

                            {% assign size_available = false %}
                            {% for check_variant in product.variants %}
                              {% if check_variant.options[size_option_index] == size_value and check_variant.available %}
                                {% assign size_available = true %}
                                {% break %}
                              {% endif %}
                            {% endfor %}

                            <button
                              type="button"
                              class="hcs-size{% if first_size_set == false and size_available %} active{% assign first_size_set = true %}{% endif %}{% unless size_available %} disabled{% endunless %}"
                              data-value="{{ size_value | escape }}"
                              {% unless size_available %}aria-disabled="true"{% endunless %}
                            >
                              {{ size_value }}
                            </button>
                          {% endunless %}
                        {% endfor %}
                      </div>
                    {% endif %}

                    <input
                      type="hidden"
                      class="hcs-variant-id"
                      value="{{ current_variant.id }}"
                    >

                    <a href="{{ product.url }}?variant={{ current_variant.id }}"
                    class="hcs-add-to-cart hcs-submit-button{% unless current_variant.available %} disabled{% endunless %}"
                    {% unless current_variant.available %}aria-disabled="true"{% endunless %}
                    >
                    {% if current_variant.available %}
                        Submit
                    {% else %}
                        Sold Out
                    {% endif %}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
.section-{{ section.id }} {
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.background }};
}

.hcs-heading {
  margin-bottom: 25px;
  font-size: 36px;
  font-weight: 700;
}

/* Outer slider */
.hcs-swiper {
  width: 100%;
  overflow: hidden;
}

.hcs-swiper > .swiper-wrapper {
  align-items: stretch;
}

.hcs-swiper > .swiper-wrapper > .swiper-slide {
  height: auto;
}

/* Card */
.hcs-card {
  background: #fff;
  border-radius: 0;
  overflow: hidden;
  position: relative;
  height: 100%;
}

.hcs-card-inner {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Inner image swiper */
.hcs-image-wrapper {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #f4f4f4;
}

.hcs-inner-swiper {
  width: 100%;
  height: 100%;
}

.hcs-inner-swiper .swiper-wrapper {
  height: 100%;
}

.hcs-inner-swiper .swiper-slide {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}

.hcs-image-link {
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
}

.hcs-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Sale badge */
.hcs-sale-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #111;
  color: #fff;
  font-size: 10px;
  font-weight: 500;
  padding: 3px 8px;
  letter-spacing: 1px;
  text-transform: uppercase;
  z-index: 2;
}

/* Content */
.hcs-content {
  padding: 12px 8px 10px;
  text-align: left;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.hcs-title {
  font-size: 13px;
  font-weight: 500;
  margin: 0 0 6px;
  line-height: 1.4;
  color: #111;
  letter-spacing: 0.2px;
}

.hcs-title a {
  text-decoration: none;
  color: #111;
}

.hcs-price {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.hcs-compare-price {
  color: #999;
  text-decoration: line-through;
  font-size: 11px;
  font-weight: 400;
}

.hcs-current-price {
  color: #111;
  font-size: 13px;
  font-weight: 600;
}

.hcs-price:has(.hcs-compare-price) .hcs-current-price {
  color: #c0392b;
}

.hcs-swatches,
.hcs-sizes {
  display: flex;
  align-items: center;
  gap: 5px;
  flex-wrap: wrap;
}

.hcs-swatches { margin-bottom: 8px; }
.hcs-sizes { margin-bottom: 10px; }

.hcs-swatch {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid #ddd;
  cursor: pointer;
  padding: 0;
  transition: transform 0.2s ease;
}

.hcs-swatch.active {
  border: 2px solid #111;
  transform: scale(1.15);
}

.hcs-size {
  font-size: 11px;
  font-weight: 500;
  border: 1px solid #e0e0e0;
  padding: 3px 7px;
  border-radius: 0;
  background: #fff;
  cursor: pointer;
  letter-spacing: 0.3px;
  transition: all 0.2s;
}

.hcs-size.active {
  background: #111;
  color: #fff;
  border-color: #111;
}

.hcs-extra {
  font-size: 11px;
  color: #888;
}

.hcs-add-to-cart {
  width: 100%;
  padding: 10px;
  border: 1px solid #111;
  background: #111;
  color: #fff;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.25s;
  display: block;
  text-align: center;
  text-decoration: none;
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-top: auto;
  box-sizing: border-box;
}

.hcs-add-to-cart:hover {
  background: #fff;
  color: #111;
}

.hcs-add-to-cart.disabled {
  background: #f5f5f5;
  color: #aaa;
  border-color: #ddd;
  cursor: not-allowed;
}

.hcs-size.disabled,
.hcs-swatch.disabled {
  opacity: 0.4;
  cursor: not-allowed;
  pointer-events: none;
}

.hcs-size.disabled { text-decoration: line-through; }

.hcs-swatch.disabled::after {
  content: '';
  position: absolute;
  top: 50%;
  left: -2px;
  width: calc(100% + 4px);
  height: 2px;
  background: #111;
  transform: rotate(-45deg);
}

.hcs-swatch.disabled { position: relative; }

/* Inner image arrows */
.hcs-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 32px;
  height: 32px;
  background: rgba(255,255,255,0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  color: #111;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.2s ease;
  user-select: none;
  line-height: 1;
}

.hcs-nav-prev { left: 0; }
.hcs-nav-next { right: 0; }

.hcs-card:hover .hcs-nav { opacity: 1; }
.hcs-nav:hover { background: #fff; }
</style>


<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  /* ── Outer collection slider (no arrows) ── */
  new Swiper('.hcs-swiper', {
    slidesPerView: {{ section.settings.columns_desktop }},
    spaceBetween: 10,
    loop: false,
    navigation: false,
    pagination: false,
    grabCursor: true,
    breakpoints: {
      0:   { slidesPerView: 1.3, spaceBetween: 6 },
      576: { slidesPerView: 2.1, spaceBetween: 8 },
      992: { slidesPerView: {{ section.settings.columns_desktop }}, spaceBetween: 10 }
    }
  });

  /* ── Inner product image swipers (no arrows) ── */
  const innerSwipers = new Map();

  document.querySelectorAll('.hcs-inner-swiper').forEach(function (el) {
    const card = el.closest('.hcs-card-inner');
    const prevBtn = el.querySelector('.hcs-nav-prev');
    const nextBtn = el.querySelector('.hcs-nav-next');

    const swiper = new Swiper(el, {
      slidesPerView: 1,
      loop: false,
      navigation: prevBtn && nextBtn
        ? { prevEl: prevBtn, nextEl: nextBtn }
        : false,
      pagination: false,
      allowTouchMove: true,
      grabCursor: true
    });
    if (card) innerSwipers.set(card, swiper);
  });

  /* ── Helpers ── */
  function formatMoney(cents) {
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, "{{ shop.money_format }}");
    }
    return (cents / 100).toFixed(2);
  }

  function getVariants(card) {
    try { return JSON.parse(card.querySelector('.hcs-variants-json').textContent); }
    catch (e) { return []; }
  }

  function getOptionIndexes(card) {
    const swatches = card.querySelector('.hcs-swatches');
    const sizes    = card.querySelector('.hcs-sizes');
    return {
      colorIndex: swatches ? parseInt(swatches.dataset.optionIndex, 10) : null,
      sizeIndex:  sizes    ? parseInt(sizes.dataset.optionIndex,    10) : null
    };
  }

  function getSelectedValues(card) {
    const activeSwatch = card.querySelector('.hcs-swatch.active');
    const activeSize   = card.querySelector('.hcs-size.active');
    return {
      color: activeSwatch ? activeSwatch.dataset.value : null,
      size:  activeSize   ? activeSize.dataset.value   : null
    };
  }

  function findVariant(card) {
    const variants = getVariants(card);
    const { colorIndex, sizeIndex } = getOptionIndexes(card);
    const { color, size } = getSelectedValues(card);
    let matched = variants.find(function (v) {
      if (color && colorIndex !== null && v.options[colorIndex] !== color) return false;
      if (size  && sizeIndex  !== null && v.options[sizeIndex]  !== size)  return false;
      return true;
    });
    return matched || variants.find(v => v.available) || variants[0];
  }

  function goToSlide(card, index) {
    const sw = innerSwipers.get(card);
    if (!sw) return;
    const total = sw.slides.length;
    index = Math.max(0, Math.min(index, total - 1));
    card.dataset.slideIndex = index;
    sw.slideTo(index, 400);
  }

  function goToImageById(card, imageId, persist) {
    if (!imageId) return;
    const sw = innerSwipers.get(card);
    if (!sw) return;
    sw.slides.forEach(function (slide, i) {
      if (String(slide.dataset.imageId) === String(imageId)) {
        if (persist) {
          card.dataset.slideIndex = i;
          sw.slideTo(i, 400);
        } else {
          sw.slideTo(i, 300);
        }
      }
    });
  }

  function updateSizeAvailability(card) {
    const variants = getVariants(card);
    const { colorIndex, sizeIndex } = getOptionIndexes(card);
    const { color } = getSelectedValues(card);
    if (sizeIndex === null) return;

    card.querySelectorAll('.hcs-size').forEach(function (btn) {
      const available = variants.some(function (v) {
        const colorOk = !color || colorIndex === null || v.options[colorIndex] === color;
        return colorOk && v.options[sizeIndex] === btn.dataset.value && v.available;
      });
      btn.classList.toggle('disabled', !available);
      available ? btn.removeAttribute('aria-disabled') : btn.setAttribute('aria-disabled', 'true');
      if (!available) btn.classList.remove('active');
    });

    if (!card.querySelector('.hcs-size.active')) {
      const first = card.querySelector('.hcs-size:not(.disabled)');
      if (first) first.classList.add('active');
    }
  }

  function updateColorAvailability(card) {
    const variants = getVariants(card);
    const { colorIndex, sizeIndex } = getOptionIndexes(card);
    const { size } = getSelectedValues(card);
    if (colorIndex === null) return;

    card.querySelectorAll('.hcs-swatch').forEach(function (btn) {
      const available = variants.some(function (v) {
        const sizeOk = !size || sizeIndex === null || v.options[sizeIndex] === size;
        return v.options[colorIndex] === btn.dataset.value && sizeOk && v.available;
      });
      btn.classList.toggle('disabled', !available);
      available ? btn.removeAttribute('aria-disabled') : btn.setAttribute('aria-disabled', 'true');
      if (!available) btn.classList.remove('active');
    });

    if (!card.querySelector('.hcs-swatch.active')) {
      const first = card.querySelector('.hcs-swatch:not(.disabled)');
      if (first) first.classList.add('active');
    }
  }

  function updateCard(card) {
    updateSizeAvailability(card);
    updateColorAvailability(card);

    const variant = findVariant(card);
    if (!variant) return;

    const variantUrl = card.dataset.productUrl + '?variant=' + variant.id;

    card.querySelector('.hcs-variant-id').value = variant.id;

    card.querySelectorAll('.hcs-image-link, .hcs-title a, .hcs-submit-button').forEach(function (el) {
      if (el.tagName.toLowerCase() === 'a') el.href = variantUrl;
    });

    if (variant.featured_image && variant.featured_image.id) {
      goToImageById(card, variant.featured_image.id, true);
    }

    const currentPriceEl = card.querySelector('.hcs-current-price');
    const priceWrapper   = card.querySelector('.hcs-price');
    let comparePriceEl   = card.querySelector('.hcs-compare-price');

    if (currentPriceEl) currentPriceEl.textContent = formatMoney(variant.price);

    if (variant.compare_at_price && variant.compare_at_price > variant.price) {
      if (!comparePriceEl && priceWrapper) {
        comparePriceEl = document.createElement('span');
        comparePriceEl.className = 'hcs-compare-price';
        priceWrapper.insertBefore(comparePriceEl, currentPriceEl);
      }
      if (comparePriceEl) comparePriceEl.textContent = formatMoney(variant.compare_at_price);
    } else if (comparePriceEl) {
      comparePriceEl.remove();
    }

    const submitBtn = card.querySelector('.hcs-submit-button');
    if (submitBtn) {
      if (variant.available) {
        submitBtn.classList.remove('disabled');
        submitBtn.removeAttribute('aria-disabled');
        submitBtn.textContent = 'Submit';
      } else {
        submitBtn.classList.add('disabled');
        submitBtn.setAttribute('aria-disabled', 'true');
        submitBtn.textContent = 'Sold Out';
      }
    }
  }

  function activate(btn, selector) {
    if (btn.classList.contains('disabled')) return false;
    btn.parentElement.querySelectorAll(selector).forEach(el => el.classList.remove('active'));
    btn.classList.add('active');
    return true;
  }

  /* ── Click events ── */
  document.addEventListener('click', function (e) {
    const swatch = e.target.closest('.hcs-swatch');
    if (swatch) {
      e.preventDefault();
      const card = swatch.closest('.hcs-card-inner');
      if (card && activate(swatch, '.hcs-swatch')) updateCard(card);
      return;
    }

    const size = e.target.closest('.hcs-size');
    if (size) {
      e.preventDefault();
      const card = size.closest('.hcs-card-inner');
      if (card && activate(size, '.hcs-size')) updateCard(card);
      return;
    }

    if (e.target.closest('.hcs-submit-button.disabled')) e.preventDefault();
  });

  /* ── Swatch hover → preview image ── */
  document.addEventListener('mouseover', function (e) {
    const swatch = e.target.closest('.hcs-swatch');
    if (!swatch || swatch.classList.contains('disabled')) return;
    const card = swatch.closest('.hcs-card-inner');
    if (!card) return;
    const imageId = swatch.dataset.imageId;
    if (imageId) goToImageById(card, imageId, false);
  });

  document.addEventListener('mouseout', function (e) {
    const swatch = e.target.closest('.hcs-swatch');
    if (!swatch) return;
    if (e.relatedTarget && e.relatedTarget.closest('.hcs-swatch')) return;
    const card = swatch.closest('.hcs-card-inner');
    if (!card) return;
    goToSlide(card, parseInt(card.dataset.slideIndex || '0', 10));
  });

  /* ── Init all cards ── */
  document.querySelectorAll('.hcs-card-inner').forEach(function (card) {
    updateCard(card);
  });
});
</script>


{% schema %}
{
  "name": "Custom Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Column",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid",
      "category": "Custom",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
