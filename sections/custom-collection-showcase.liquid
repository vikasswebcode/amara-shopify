{% comment %} Collection Showcase — v2 {% endcomment %}

{% assign products_limit = section.settings.products_per_row | times: section.settings.rows %}
{% assign tablet_cols = section.settings.products_per_row | minus: 1 %}
{% if tablet_cols < 2 %}{% assign tablet_cols = 2 %}{% endif %}

<style>
.cs-wrap { max-width: 1400px; margin: 0 auto; padding: 50px 20px; }
.cs-heading { text-align: center; font-size: clamp(1.4rem, 2.5vw, 2.2rem); font-weight: 700; margin: 0 0 32px; color: #111; }
.cs-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.products_per_row }}, 1fr);
  gap: 24px;
}
@media(max-width:1024px){ .cs-grid { grid-template-columns: repeat({{ tablet_cols }}, 1fr); } }
@media(max-width:768px) { .cs-grid { grid-template-columns: repeat(2,1fr); gap:14px; } }
@media(max-width:480px) { .cs-grid { grid-template-columns: 1fr; } }

/* Card */
.cs-card { background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,.07); transition:transform .2s,box-shadow .2s; display:flex; flex-direction:column; }
.cs-card:hover { transform:translateY(-4px); box-shadow:0 8px 28px rgba(0,0,0,.12); }

/* Image */
.cs-img-box { position:relative; aspect-ratio:1; overflow:hidden; background:#f4f4f4; }
.cs-img-box a { display:block; height:100%; }
.cs-img { width:100%; height:100%; object-fit:cover; transition:transform .4s,opacity .25s; }
.cs-card:hover .cs-img { transform:scale(1.05); }
.cs-img.fading { opacity:.5; }
.cs-sale-badge { position:absolute; top:10px; left:10px; background:#e63946; color:#fff; font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; text-transform:uppercase; letter-spacing:.5px; }

/* Body */
.cs-body { padding:14px; display:flex; flex-direction:column; gap:9px; flex:1; }
.cs-title { font-size:.92rem; font-weight:600; margin:0; line-height:1.35; }
.cs-title a { color:#111; text-decoration:none; }
.cs-title a:hover { color:#555; }

/* Price */
.cs-price { display:flex; align-items:center; gap:7px; flex-wrap:wrap; min-height:22px; }
.cs-p-reg { font-weight:700; font-size:.95rem; color:#111; }
.cs-p-sale { font-weight:700; font-size:.95rem; color:#e63946; }
.cs-p-comp { font-size:.82rem; color:#aaa; text-decoration:line-through; }

/* Swatches */
.cs-opt-label { font-size:.73rem; color:#777; display:block; margin-bottom:5px; }
.cs-opt-label b { color:#111; font-weight:600; }
.cs-swatches { display:flex; flex-wrap:wrap; gap:5px; }
.cs-swatch {
  width:22px; height:22px; border-radius:50%; border:2px solid transparent;
  cursor:pointer; padding:0; box-shadow:inset 0 0 0 1px rgba(0,0,0,.15);
  transition:transform .15s,border-color .15s; outline:none;
}
.cs-swatch:hover { transform:scale(1.2); }
.cs-swatch.active { border-color:#111; box-shadow:0 0 0 2px #111,inset 0 0 0 1px rgba(0,0,0,.1); }

/* Sizes */
.cs-sizes { display:flex; flex-wrap:wrap; gap:5px; }
.cs-sz {
  min-width:34px; height:30px; padding:0 8px; border:1.5px solid #ddd;
  border-radius:6px; background:#fff; font-size:.75rem; font-weight:500;
  cursor:pointer; color:#111; transition:all .15s;
}
.cs-sz:hover:not(.sold) { border-color:#111; }
.cs-sz.active { background:#111; color:#fff; border-color:#111; }
.cs-sz.sold { color:#ccc; border-color:#eee; cursor:not-allowed; text-decoration:line-through; }

/* ATC */
.cs-atc {
  width:100%; padding:11px; background:#111; color:#fff; border:none;
  border-radius:8px; font-size:.85rem; font-weight:600; cursor:pointer;
  letter-spacing:.4px; transition:background .2s,transform .1s; margin-top:auto;
}
.cs-atc:hover:not(:disabled) { background:#333; }
.cs-atc:active:not(:disabled) { transform:scale(.98); }
.cs-atc:disabled { background:#ccc; cursor:not-allowed; }
.cs-atc.ok { background:#2a9d2a; }
.cs-atc.busy { opacity:.65; pointer-events:none; }
.cs-fb { font-size:.73rem; min-height:15px; text-align:center; }
.cs-empty { text-align:center; color:#aaa; padding:60px 20px; }
</style>

<div class="cs-wrap" id="cs-{{ section.id }}">

  {% if section.settings.heading != blank %}
    <h2 class="cs-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% assign picked = collections[section.settings.collection] %}

  {% if picked != blank and picked.products.size > 0 %}
    <div class="cs-grid">

      {% for product in picked.products limit: products_limit %}

        {%- assign cidx = nil -%}
        {%- assign sidx = nil -%}
        {%- for o in product.options -%}
          {%- assign ol = o | downcase -%}
          {%- if ol == 'color' or ol == 'colour' -%}{%- assign cidx = forloop.index0 -%}{%- endif -%}
          {%- if ol == 'size' -%}{%- assign sidx = forloop.index0 -%}{%- endif -%}
        {%- endfor -%}

        {%- assign fv = product.first_available_variant | default: product.variants.first -%}

        <div class="cs-card" data-pid="{{ product.id }}">

          <!-- IMAGE -->
          <div class="cs-img-box">
            <a href="{{ product.url }}">
              <img
                id="cs-img-{{ product.id }}"
                class="cs-img"
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="600" height="600" loading="lazy"
              >
            </a>
            {%- if product.compare_at_price > product.price -%}
              <span class="cs-sale-badge">Sale</span>
            {%- endif -%}
          </div>

          <!-- BODY -->
          <div class="cs-body">

            <!-- Title -->
            <h3 class="cs-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>

            <!-- Price -->
            <div class="cs-price" id="cs-price-{{ product.id }}">
              {%- if product.compare_at_price > product.price -%}
                <span class="cs-p-sale">{{ product.price | money }}</span>
                <span class="cs-p-comp">{{ product.compare_at_price | money }}</span>
              {%- else -%}
                <span class="cs-p-reg">{{ product.price | money }}</span>
              {%- endif -%}
            </div>

            <!-- Color Swatches -->
            {%- if cidx != nil -%}
              {%- assign copt = product.options_with_values[cidx] -%}
              <div>
                <span class="cs-opt-label">Color: <b id="cs-cv-{{ product.id }}">{{ copt.values.first }}</b></span>
                <div class="cs-swatches">
                  {%- for cv in copt.values -%}
                    <button
                      class="cs-swatch{% if forloop.first %} active{% endif %}"
                      data-pid="{{ product.id }}"
                      data-color="{{ cv }}"
                      data-cidx="{{ cidx }}"
                      style="background-color:{{ cv | handle }};"
                      title="{{ cv }}"
                      aria-label="{{ cv }}"
                    ></button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

            <!-- Size Buttons -->
            {%- if sidx != nil -%}
              {%- assign sopt = product.options_with_values[sidx] -%}
              <div>
                <span class="cs-opt-label">Size: <b id="cs-sv-{{ product.id }}">{{ sopt.values.first }}</b></span>
                <div class="cs-sizes">
                  {%- for sv in sopt.values -%}
                    <button
                      class="cs-sz{% if forloop.first %} active{% endif %}"
                      data-pid="{{ product.id }}"
                      data-size="{{ sv }}"
                      data-sidx="{{ sidx }}"
                    >{{ sv }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

            <!-- Variants JSON -->
            <script type="application/json" id="cs-vd-{{ product.id }}">[{% for v in product.variants %}{"id":{{ v.id }},"avail":{{ v.available }},"price":{{ v.price }},"comp":{% if v.compare_at_price %}{{ v.compare_at_price }}{% else %}null{% endif %},"opts":{{ v.options | json }},"img":{% if v.featured_image %}"{{ v.featured_image.src | image_url: width: 600 }}"{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>

            <!-- Add to Cart -->
            <button
              id="cs-atc-{{ product.id }}"
              class="cs-atc"
              data-pid="{{ product.id }}"
              data-vid="{{ fv.id }}"
              {%- unless product.available %} disabled{%- endunless -%}
            >{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</button>
            <div class="cs-fb" id="cs-fb-{{ product.id }}"></div>

          </div>
        </div>
      {% endfor %}

    </div>
  {% else %}
    <p class="cs-empty">Please select a collection in the theme editor.</p>
  {% endif %}
</div>

<script>
(function(){
  function vdata(pid){ try{ return JSON.parse(document.getElementById('cs-vd-'+pid).textContent); }catch(e){ return []; } }
  function card(pid){ return document.querySelector('.cs-card[data-pid="'+pid+'"]'); }

  function selOpts(pid){
    var c=card(pid), opts=[];
    var sw=c&&c.querySelector('.cs-swatch.active');
    if(sw) opts[+sw.dataset.cidx]=sw.dataset.color;
    var sz=c&&c.querySelector('.cs-sz.active');
    if(sz) opts[+sz.dataset.sidx]=sz.dataset.size;
    return opts;
  }

  function findV(variants, opts){
    return variants.find(function(v){
      return opts.every(function(val,i){ return val===undefined||v.opts[i]===val; });
    });
  }

  function money(cents){
    return (cents/100).toLocaleString('en-US',{style:'currency',currency:'USD'});
  }

  function setPrice(pid,v){
    var el=document.getElementById('cs-price-'+pid); if(!el||!v) return;
    el.innerHTML = v.comp&&v.comp>v.price
      ? '<span class="cs-p-sale">'+money(v.price)+'</span><span class="cs-p-comp">'+money(v.comp)+'</span>'
      : '<span class="cs-p-reg">'+money(v.price)+'</span>';
  }

  function setImg(pid,v){
    if(!v||!v.img) return;
    var img=document.getElementById('cs-img-'+pid); if(!img) return;
    img.classList.add('fading');
    var t=new Image();
    t.onload=function(){ img.src=v.img; img.classList.remove('fading'); };
    t.src=v.img;
  }

  function setBtn(pid,v){
    var btn=document.getElementById('cs-atc-'+pid); if(!btn) return;
    if(!v||!v.avail){ btn.disabled=true; btn.textContent='Sold Out'; }
    else{ btn.disabled=false; btn.dataset.vid=v.id; if(!btn.classList.contains('ok')) btn.textContent='Add to Cart'; }
  }

  function refreshSizes(pid){
    var c=card(pid); if(!c) return;
    var variants=vdata(pid);
    var sw=c.querySelector('.cs-swatch.active');
    var ci=sw?+sw.dataset.cidx:null, cv=sw?sw.dataset.color:null;
    c.querySelectorAll('.cs-sz').forEach(function(b){
      var si=+b.dataset.sidx, sv=b.dataset.size;
      var ok=variants.some(function(v){
        return (ci===null||v.opts[ci]===cv) && v.opts[si]===sv && v.avail;
      });
      b.classList.toggle('sold',!ok);
    });
  }

  function sync(pid){
    var v=findV(vdata(pid),selOpts(pid));
    setImg(pid,v); setPrice(pid,v); setBtn(pid,v);
  }

  // Swatch click
  document.addEventListener('click',function(e){
    var sw=e.target.closest('.cs-swatch'); if(!sw) return;
    var pid=sw.dataset.pid, c=card(pid);
    c.querySelectorAll('.cs-swatch').forEach(function(s){ s.classList.remove('active'); });
    sw.classList.add('active');
    var lbl=document.getElementById('cs-cv-'+pid); if(lbl) lbl.textContent=sw.dataset.color;
    refreshSizes(pid);
    sync(pid);
  });

  // Size click
  document.addEventListener('click',function(e){
    var sb=e.target.closest('.cs-sz'); if(!sb||sb.classList.contains('sold')) return;
    var pid=sb.dataset.pid, c=card(pid);
    c.querySelectorAll('.cs-sz').forEach(function(b){ b.classList.remove('active'); });
    sb.classList.add('active');
    var lbl=document.getElementById('cs-sv-'+pid); if(lbl) lbl.textContent=sb.dataset.size;
    sync(pid);
  });

  // ATC click
  document.addEventListener('click',function(e){
    var btn=e.target.closest('.cs-atc'); if(!btn||btn.disabled) return;
    var pid=btn.dataset.pid, vid=btn.dataset.vid;
    var fb=document.getElementById('cs-fb-'+pid);
    btn.classList.add('busy'); btn.textContent='Adding...';
    if(fb){ fb.textContent=''; fb.style.color=''; }
    fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:+vid,quantity:1})
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
      btn.classList.remove('busy');
      if(d.status){
        btn.textContent='Add to Cart';
        if(fb){ fb.textContent=d.description||'Error.'; fb.style.color='#e63946'; }
      } else {
        btn.classList.add('ok'); btn.textContent='Added ✓';
        if(fb){ fb.textContent='Added to cart!'; fb.style.color='#2a9d2a'; }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        setTimeout(function(){ btn.classList.remove('ok'); btn.textContent='Add to Cart'; if(fb) fb.textContent=''; },2500);
      }
    })
    .catch(function(){
      btn.classList.remove('busy'); btn.textContent='Add to Cart';
      if(fb){ fb.textContent='Something went wrong.'; fb.style.color='#e63946'; }
    });
  });

})();
</script>

{% schema %}
{
  "name": "Collection Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop the Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Products per row",
      "default": 4
    },
    {
      "type": "range",
      "id": "rows",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Rows",
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Collection Showcase"
    }
  ]
}
{% endschema %}
